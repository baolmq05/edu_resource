# Sao chép file này thành server/.env và điền giá trị (KHÔNG commit file .env)
PORT=3001
ALLOWED_ORIGIN=http://localhost:5173

# OAuth client (Web application) trong Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Lấy bằng: npm run token  (đăng nhập tài khoản Google dùng chung)
GOOGLE_REFRESH_TOKEN=

# ID thư mục gốc trên Drive chung (phần sau /folders/ trong URL thư mục)
DRIVE_ROOT_FOLDER_ID=
